# ============================================================
# Server Settings
# ============================================================

# Port the backend API listens on inside the Docker container.
# Usually matches BACKEND_PORT in docker-compose.yml
PORT=3000

# Fallback port: config.ts uses `process.env.PORT ?? process.env.BACKEND_PORT
# ?? DEFAULT_PORT`, so this is only used if PORT isn't set.
BACKEND_PORT=3000



# ============================================================
# Database
# ============================================================

# PostgreSQL connection string.
# If using the default Docker network, 'db' is the service name.
# '5432' is the internal postgres port; '5433' on host allows avoiding conflicts.
# NOTE: this value is only used when running the backend directly (outside
# Docker). When running via `docker compose up`, docker-compose.yml sets its
# own DATABASE_URL (pointing at db:5432) which overrides this one — this
# value has no effect in that case.
DATABASE_URL="postgresql://soundbin:soundbin_dev@localhost:5433/soundbin?schema=public"

# ============================================================
# Security
# ============================================================

# Secret key for signing JWTs. Generate a long random string for production.
# You can use `openssl rand -hex 32` in your terminal to generate one.
JWT_SECRET=your-long-random-secret-here



# ============================================================
# File Storage
# ============================================================

# Path inside the container where song files are stored.
DOCKER_SONG_FILE_LOCATION="/app/uploads"



# ============================================================
# Development Features
# ============================================================

# Forces file watching to use polling instead of native filesystem events.
# Set to true if file changes aren't triggering HMR in your environment (e.g., macOS/WSL2).
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=100
