#
# Backend
#

# Port this API listens on. NOTE: this is the *backend's* port — the file
# previously set PORT=5173 (the frontend's), so a local `npm run dev` bound
# the wrong port. BACKEND_PORT is still read as a fallback.
PORT=3000
BACKEND_PORT=3000

DATABASE_URL="postgresql://soundbin:soundbin_dev@localhost:5433/soundbin?schema=public"


#
# CORS — which browser origins may call this API
#
# Simple case: just the port the frontend dev server runs on. localhost and
# 127.0.0.1 are both allowed automatically.
FRONTEND_PORT=5173

# Full control, comma-separated. Overrides FRONTEND_PORT entirely. Use this
# when serving over a LAN IP or a domain name:
# FRONTEND_ORIGINS="http://localhost:5173,http://192.168.1.50:5173"


#
# Used for storing the songs files
#

# Location for docker
DOCKER_SONG_FILE_LOCATION="/app/uploads"
# Location made by user
SONG_FILE_LOCATION="./"


CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=100

JWT_SECRET=your-long-random-secret-here
