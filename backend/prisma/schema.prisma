// This is your Prisma schema file for SoundBin
// Prisma version 6.19.3

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// ~~~~~~~~~~ User Management ~~~~~~~~~~

// User model for authentication
model User {
  user_id       Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  password_hash      String    //text
  display_name  String    @db.VarChar(100)
  register_date DateTime  @default(now()) @db.Timestamptz(0)
  is_active     Boolean   @default(true)
  is_admin      Boolean   @default(false)
  is_approved   Boolean   @default(false)
  last_login    DateTime? @db.Timestamptz(6)

  // back relations
  favorites UserFavorite[]
  activity Activity[]
  tags UserTag[]
  playlist Playlist[]

  @@map("users")
}

model UserFavorite {
  favorite_id Int   @id @default(autoincrement())
  user_id     Int
  track_id    Int
  date_added  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  track Track @relation(fields: [track_id], references: [track_id], onDelete: Cascade)

  @@unique([user_id, track_id])
  @@map("user_favorites")
}

// ~~~~~~~~~~ Logging & Analytics ~~~~~~~~~~

// Logging & Analytics model
model Activity {
  activity_id     Int   @id @default(autoincrement())
  user_id         Int
  track_id        Int?
  played_at       DateTime @default(now()) @db.Timestamptz(6)
  duration_played Int?

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  track Track? @relation(fields: [track_id], references: [track_id], onDelete: SetNull)

  @@index([user_id, played_at])
  @@index([track_id])
  @@map("user_activity")
}

// ~~~~~~~~~~ Music Library ~~~~~~~~~~

model Track{
  track_id Int @id @default(autoincrement())
  title String @db.VarChar(200)
  album_id Int?
  release_date  DateTime? @db.Date
  duration  Int
  cover_art_url String? @db.VarChar(500)

  album Album? @relation(fields: [album_id], references: [album_id], onDelete: SetNull)

  files TrackFile[]
  genres TrackGenre[]
  lyrics Lyrics[]
  contributors TrackContributor[]
  favorites UserFavorite[]
  activity Activity[]
  tags UserTag[]
  albumSequence AlbumTrackSequence[]
  playlistItems PlaylistItem[]

  @@index([album_id])
  @@map("tracks")
}

model Artist {
  artist_id Int  @id @default(autoincrement())
  name      String  @db.VarChar(150)
  bio       String?
  image_url String? @db.VarChar(500)

  albums Album[]
  contributions TrackContributor[]

  @@map("artists")
}

model Album {
  album_id      Int    @id @default(autoincrement())
  title         String  @db.VarChar(200)
  artist_id     Int?
  release_date  DateTime? @db.Date
  cover_art_url String?   @db.VarChar(500)

  artist Artist? @relation(fields: [artist_id], references: [artist_id], onDelete: SetNull)

  tracks Track[]
  sequence AlbumTrackSequence[]

  @@index([artist_id])
  @@map("albums")
}

model TrackContributor {
  contribution_id Int @id @default(autoincrement())
  track_id Int
  artist_id Int
  role String?  @db.VarChar(100)

  track Track @relation(fields: [track_id], references: [track_id], onDelete: Cascade)
  artist Artist @relation(fields: [artist_id], references: [artist_id], onDelete: Cascade)

  @@unique([track_id, artist_id, role])
  @@map("track_contributors")
}

model UserTag {
  tag_id Int  @id @default(autoincrement())
  track_id Int
  tag_name String @db.VarChar(50)
  user_id Int

  track Track @relation(fields: [track_id], references: [track_id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, track_id, tag_name])
  @@map("user_tags")
}

model AlbumTrackSequence {
  album_id Int
  track_id Int
  sequence_number Int

  album Album @relation(fields: [album_id], references: [album_id], onDelete: Cascade)
  track Track @relation(fields: [track_id], references: [track_id], onDelete: Cascade)

  @@id([album_id, track_id])
  @@unique([album_id, sequence_number])
  @@map("album_track_sequence")
}

model Playlist {
  playlist_id Int @id @default(autoincrement())
  user_id Int?
  name String @db.VarChar(100)
  description String?
  source_type String @default("manual") @db.VarChar(100)
  date_created DateTime @default(now()) @db.Timestamptz(3)
  cover_art_url String?   @db.VarChar(500)

user User? @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
items PlaylistItem[]

@@map("playlists")
}

model PlaylistItem {
  playlist_item_id Int @id @default(autoincrement())
  playlist_id Int
  track_id Int
  sequence_number Int

  playlist Playlist @relation(fields: [playlist_id], references: [playlist_id], onDelete: Cascade)
  track Track @relation(fields: [track_id], references: [track_id], onDelete: Cascade)

  @@unique([playlist_id, sequence_number])
  @@map("playlist_items")
}

// ~~~~~~~~~~ Content & Streaming Details ~~~~~~~~~~

model Genre {
  genre_id Int @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  tracks TrackGenre[]

  @@map("genres")
}

model TrackGenre {
  track_id Int
  genre_id Int

  track Track @relation(fields: [track_id], references: [track_id], onDelete: Cascade)
  genre Genre @relation(fields: [genre_id], references: [genre_id], onDelete: Cascade)

  @@id([track_id, genre_id])
  @@map("track_genre")
}

model TrackFile {
  file_id Int @id @default(autoincrement())
  track_id Int
  storage_path_url String @unique @db.VarChar(500)
  file_hash String? @unique @db.VarChar(64) // nullable only for rows that predate hash-based dedup; always set for new uploads
  bitrate Int @db.SmallInt //KBps
  sample_rate Int
  channels Int @db.SmallInt
  codec String @db.VarChar(20)
  file_mtime DateTime @db.Timestamptz(6)

  track Track @relation(fields: [track_id], references: [track_id], onDelete: Cascade)

  @@map("track_files")
}

model Lyrics {
  track_id Int
  language String @db.VarChar(10)
  lyric_test String?

  track Track @relation(fields: [track_id], references: [track_id], onDelete: Cascade)

  @@id([track_id, language])
  @@map("lyrics_connection")
}
