// This is your Prisma schema file for SoundBin

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  user_id       String    @id
  username      String    @unique
  password      String
  display_name  String
  register_date DateTime  @default(now())
  is_active     Boolean   @default(true)
  is_admin      Boolean
  last_login    DateTime?

  @@map("users")
}

model UserFavorites {
  favorite_id String   @id
  user_id     String
  track_id    String
  date_added  DateTime @default(now())

  @@map("user_favorites")
}

// Logging & Analytics model
model Activity {
  activity_id     String   @id
  user_id         Int
  track_id        Int?
  played_at       DateTime @default(now())
  duration_played Int?

  @@map("user_activity")
}

// artist
model Artist {
  artist_id String  @id
  name      String
  bio       String
  image_url String?

  @@map("artists")
}

model Album {
  album_id      String    @id
  title         String
  artist_id     Int
  release_date  DateTime?
  cover_art_url String?

  @@map("albums")
}

model Tracks{
  track_id      String   @id
  title         String
  artist_id     Int
  album_id      Int?
  duration      Int
  file_path     String
  genre         String?
  release_date  DateTime?
  lyrics        String?

  @@map("tracks")
}

