# ============================================================
# Application Settings
# ============================================================

# Port the Vite dev server listens on (read by vite.config.ts).
PORT=5173


# ============================================================
# Backend Connection (Vite Proxy / API URL)
# ============================================================

# BACKEND_PORT / BACKEND_URL: used by vite.config.ts (server-side, not sent
# to the browser) to configure the dev-server proxy for /api, /songs, /assets.
# BACKEND_URL wins if set; otherwise falls back to http://localhost:BACKEND_PORT.
# Not needed when running via `docker compose up` — docker-compose.yml sets
# BACKEND_URL directly on the container in that case.
BACKEND_PORT=3000
# BACKEND_URL="http://localhost:3000"

# VITE_API_URL: read by src/config.ts in the *browser* bundle. If set, all API
# calls go to this absolute URL. Leave unset to use the Vite proxy above
# instead (recommended for local dev — works from any device on the network
# without hardcoding a host).
# VITE_API_URL="http://localhost:3000"
