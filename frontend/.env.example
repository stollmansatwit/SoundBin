#
# Application
#

# Port the Vite dev server listens on (read by vite.config.ts).
PORT=5173


#
# Backend API
#
# The frontend talks to the backend from the *browser*, so these must be
# reachable from the user's machine, not from inside the Docker network.
#
# Only VITE_-prefixed variables are exposed to browser code by Vite.

# Option A — set the whole URL in one go. Wins over the two values below.
# Uncomment and edit this when the backend is not on localhost:
# VITE_API_URL="http://192.168.1.50:3000"

# Option B — host and port separately. This is the usual way to change the port.
VITE_APPLICATION_URL="http://localhost"
VITE_BACKEND_PORT=3000
