#
# Ports used by docker compose.
#
# Docker Compose automatically reads this file (it must sit next to
# docker-compose.yml) and substitutes the values into ${...} placeholders.
# Change a port here and `docker compose up` picks it up everywhere: the
# published port, the port the app listens on, and the backend's CORS list.
#

FRONTEND_PORT=5173
BACKEND_PORT=3000
