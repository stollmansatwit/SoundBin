# ============================================================
# Docker Compose Global Configuration
# ============================================================
# This file is read automatically by `docker compose up`.
# Place this file in the same directory as docker-compose.yml.
# Variables here override defaults defined in docker-compose.yml.
# ============================================================

# FRONTEND_PORT: The port exposed on your host machine for the web UI.
# - Change this if 5173 is already in use.
# - This value is used by:
#   1. Docker to map the container port to your host (e.g., 5174:5173).
#   2. The Backend service, to update CORS settings automatically.
FRONTEND_PORT=5173

# BACKEND_PORT: The port exposed on your host machine for the API.
# - Change this if 3000 is already in use.
# - This value is used by:
#   1. Docker to map the container port to your host.
#   2. The Frontend service, to configure the proxy/API URL.
BACKEND_PORT=3000

# ============================================================
# Development Defaults (Optional)
# ============================================================
# You can uncomment these if you want to set defaults for specific environments,
# but it's usually cleaner to let docker-compose.yml handle app-specific defaults
# or rely on separate .env files in frontend/ and backend/ directories.
